load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bazel:defs.bzl", "NEXT_APP_PKG_EXCLUDE", "bazel_ts_tsconfig", "next_app_build")

npm_link_all_packages()

# First-party workspace package `docs` (the Next.js app source). Required so the
# workspace:* link that packages/docs-e2e declares resolves.
npm_package(
    name = "pkg",
    srcs = glob(["**/*"], exclude = NEXT_APP_PKG_EXCLUDE),
    visibility = ["//visibility:public"],
)

# Next consumes the generated UI tree. Identical projection bytes reuse the
# cached Next artifact even though a fresh Next build is not reproducible.
next_app_build()

# The "docs" CI check at the TS layer: compile + type-check the logic that
# consumes @repo/ui. It depends ONLY on the `sub` leaf — never on `add`.
ts_project(
    name = "logic",
    srcs = [
        "bazel/logic.test.ts",
        "bazel/logic.ts",
    ],
    declaration = True,
    tsconfig = bazel_ts_tsconfig(types = ["node"]),
    deps = [
        ":node_modules/@types/node",
        "//packages/ui/src/utils/sub",
    ],
)

js_test(
    name = "test",
    data = [":logic"],
    entry_point = "bazel/logic.test.js",
)
