load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@npm//:typescript/package_json.bzl", typescript_bin = "bin")

# Node strips types without checking them, so this test is what checks them.
typescript_bin.tsc_test(
    name = "types_test",
    args = ["-p", "tools/bazel/tsconfig.json"],
    data = glob(["*.ts"]) + [
        "package.json",
        "tsconfig.json",
        "//:script_sources",
        "//:node_modules/@types/node",
        "//:node_modules/esbuild",
        "//:node_modules/tar",
        "//:node_modules/typescript",
    ],
)

_PROJECTION_SOURCES = [
    "package.json",
    "projection.ts",
    "projection-resolve.ts",
    "projection-slice.ts",
]

js_binary(
    name = "project",
    entry_point = "projection.ts",
    data = _PROJECTION_SOURCES + ["//:node_modules/typescript"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "projection_test",
    entry_point = "projection.test.ts",
    data = _PROJECTION_SOURCES + ["link-projection.ts", "//:node_modules/esbuild", "//:node_modules/typescript"],
)

# `--define=projection=strict` turns every projection fallback into an error.
config_setting(
    name = "strict_projection",
    define_values = {"projection": "strict"},
    visibility = ["//visibility:public"],
)

js_library(
    name = "compare_archives",
    srcs = ["compare-archives.ts"],
    data = ["package.json"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "bundle_test",
    entry_point = "bundle-test.ts",
    data = ["package.json", "//:node_modules/esbuild"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "build_next",
    entry_point = "build-next.ts",
    data = ["package.json", "trace-fs.ts", "check-artifact.ts", "link-projection.ts", "materialize-inputs.ts", "//:node_modules/vercel", "//:node_modules/tar"],
    visibility = ["//visibility:public"],
)

exports_files(["chromium-pins.json", "run-playwright.ts", "artifact-server.ts", "check-artifact.ts"])

config_setting(
    name = "production",
    define_values = {"deploy_env": "production"},
    visibility = ["//visibility:public"],
)

js_library(
    name = "artifact_helpers",
    srcs = ["package.json", "artifact-server.ts", "check-artifact.ts"],
    deps = ["//:node_modules/tar"],
    visibility = ["//visibility:public"],
)
js_library(
    name = "test_runner",
    srcs = ["run-playwright.ts"],
    data = ["package.json"],
    deps = [":artifact_helpers"],
    visibility = ["//visibility:public"],
)
js_library(
    name = "typecheck",
    srcs = ["typecheck.ts"],
    data = ["package.json"],
    visibility = ["//visibility:public"],
)

# A js_test entry point carries one file, so tests add helpers to their data.
js_library(
    name = "link_projection",
    srcs = ["package.json", "link-projection.ts"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "lint",
    srcs = ["lint.ts"],
    data = ["package.json"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "check_build_files",
    srcs = ["check-build-files.ts"],
    data = ["package.json"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "check_deployment_test",
    entry_point = "check-deployment.test.ts",
    data = ["package.json", "check-deployment.ts", ":artifact_helpers", "//:node_modules/tar"],
)

js_test(
    name = "vercel_cache_test",
    entry_point = "vercel-cache.test.ts",
    data = ["package.json", "vercel-cache.ts"],
)
