"""The pnpm workspace packages, read from pnpm-workspace.yaml and each package.json.

`next_app()` projects the workspace packages an app depends on. This repository
rule lists them, so a new shared package needs no Starlark change. Bazel reruns
it when pnpm-workspace.yaml, a package folder or a package.json changes.
"""

def _patterns(text):
    patterns = []
    in_packages = False
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if not line.startswith((" ", "-")):
            in_packages = stripped == "packages:"
            continue
        if in_packages and stripped.startswith("- "):
            patterns.append(stripped[2:].strip().strip("\"'"))
    return patterns

def _workspace_packages_impl(rctx):
    workspace_file = rctx.path(Label("//:pnpm-workspace.yaml"))
    root = workspace_file.dirname
    packages = {}
    for pattern in _patterns(rctx.read(workspace_file)):
        if pattern.startswith("!"):
            continue
        if not pattern.endswith("/*") or "*" in pattern[:-2]:
            fail("pnpm-workspace.yaml: workspace_packages reads 'dir/*' patterns only, not '%s'" % pattern)
        base = root.get_child(pattern[:-2])
        if not base.exists:
            continue
        for child in base.readdir():
            manifest = child.get_child("package.json")
            rctx.watch(manifest)
            if not manifest.exists:
                continue
            name = json.decode(rctx.read(manifest)).get("name")
            if name:
                packages[name] = pattern[:-2] + "/" + child.basename
    rctx.file("BUILD.bazel", "")
    rctx.file(
        "packages.bzl",
        "\"\"\"Generated by //tools/bazel:workspace.bzl.\"\"\"\n\n" +
        "# Workspace package name to its directory.\n" +
        "WORKSPACE_PACKAGES = " + json.encode_indent(packages, indent = "    ") + "\n",
    )

workspace_packages = repository_rule(
    implementation = _workspace_packages_impl,
    local = True,
)
