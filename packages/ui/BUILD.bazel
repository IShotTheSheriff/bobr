load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages", "npm_link_targets")
load("//tools/bazel:defs.bzl", "typecheck", "unit_tests")

npm_link_all_packages()

SOURCES = ["package.json"] + glob(["src/**/*"], exclude = ["src/**/*.test.*"])

# First-party workspace package `@repo/ui`, linked into apps that depend on it.
# Its exports map points at TypeScript sources; each app's projection reads them.
npm_package(
    name = "pkg",
    srcs = SOURCES,
    visibility = ["//visibility:public"],
)

unit_tests(srcs = SOURCES + npm_link_targets())

typecheck(srcs = ["package.json", "tsconfig.json"] + glob(["src/**/*"]) + npm_link_targets())
