load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")

# Links the full node_modules tree + the pnpm package store
# (bazel-bin/node_modules/.aspect_rules_js) at the workspace root.
npm_link_all_packages()

# Files referenced by MODULE.bazel extensions and downstream rules.
exports_files([
    ".nvmrc",
    "package.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    ".npmrc",
])

# A glob never enters a directory that has its own BUILD.bazel, so this only
# matches workspace packages that Bazel would otherwise skip. The paths are the
# test's arguments, so a new package changes its cache key.
js_test(
    name = "build_files_test",
    entry_point = "//tools/bazel:check_build_files",
    args = glob(["apps/*/package.json", "packages/*/package.json"], allow_empty = True),
)
